# Copy to docker/.env (gitignored) and fill in.

# Host directories (absolute paths on the Docker host): the server's state (lanes.json and the rest) and its login.
STATE_DIR=/srv/spotify-discovery/state
AUTH_DIR=/srv/spotify-discovery/auth

# Time zone for the crontab and for which day "today" is (passed to the server too).
TZ=UTC

# Any OpenAI-compatible gateway with tool calling (a LiteLLM proxy, Ollama, OpenAI).
LLM_BASE_URL=http://localhost:4000/v1
LLM_API_KEY=
LLM_MODEL=
# "none" turns Qwen's thinking off on Ollama.
LLM_REASONING_EFFORT=none
# Let the final choice alone think (Qwen through Ollama: anything but none turns thinking on).
CHOICE_REASONING_EFFORT=medium

# Where each lane's report goes, and where failure notices go (defaults to the same webhook).
DISCORD_WEBHOOK_URL=
DISCORD_FAILURE_WEBHOOK_URL=

# The research tools: a SearXNG instance (with the JSON format enabled) and a Firecrawl instance.
SEARXNG_URL=http://localhost:8080
FIRECRAWL_URL=http://localhost:3002
# FIRECRAWL_API_KEY=

# Research budgets, enforced in code (defaults 20 searches, 10 page reads, 8 verify_tracks calls).
# RESEARCH_SEARCHES=20
# RESEARCH_PAGES=10
# RESEARCH_VERIFY_CALLS=8
# How many tracks research aims for, and the fewest verified before it tries once more (defaults 6, 12, 3).
# RESEARCH_TRACKS_MIN=6
# RESEARCH_TRACKS_MAX=12
# RESEARCH_MIN_VERIFIED=3

# spotify-discovery-mcp settings; every SPOTIFY_DISCOVERY_* variable is passed to the server.
# SPOTIFY_DISCOVERY_DIR and SPOTIFY_DISCOVERY_AUTH default to /data and /auth/auth.json.
# Genre lookups: any of beatport, soundcloud, deezer (off by default; see its README).
# SPOTIFY_DISCOVERY_METADATA=deezer
